{
	"info": {
		"_postman_id": "0305e373-537b-4be2-8afe-8cdce04bd286",
		"name": "StorefrontMCPChatAgent",
		"description": "Companion collection to the streamlined StorefrontMCP Chat agent demo backend.\n\nConfigure variables before sending requests\n\n- `store` - shopify store key for your storefront. This should be the subdomain value used to access your Storefront API graphql endpoint.\n    \n    - For instance, if your api domain is `https://mystore.myshopify.com`, set this to `mystore`\n        \n- `store_name` - Human readable brand name\n    \n    - e.g. `My Store`\n        \n- `conversation_id` - identifier for persistent chat history\n    \n    - e.g. `conversation-1`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "17685634",
		"_collection_link": "https://brandingbrand.postman.co/workspace/1d67de9e-50d0-44da-8682-0a0239245f63/collection/17685634-0305e373-537b-4be2-8afe-8cdce04bd286?action=share&source=collection_link&creator=17685634"
	},
	"item": [
