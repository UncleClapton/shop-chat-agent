					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/chat?conversation_id={{conversation_id}}",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"chat"
							],
							"query": [
