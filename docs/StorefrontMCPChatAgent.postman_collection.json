						"description": "Fetches the chat history for the provied conversation ID"
					},
					"response": []
				},
				{
					"name": "New Chat Message",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Find pants over $200\",\n    \"shopName\": \"{{store_name}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:3000/chat?store={{store}}&conversation_id={{conversation_id}}",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"chat"
							],
							"query": [
								{
									"key": "store",
									"value": "{{store}}"
								},
								{
									"key": "conversation_id",
									"value": "{{conversation_id}}"
								}
							]
						},
						"description": "Posts a new user message to the specified conversation, and responds with a Server-Sent Events (SSE) stream to enable progressive rendering of the model's response\n\nIf no conversation ID is provided, a new conversation will be generated and the ID will be returned in the `id` event for future reference."
					},
					"response": []
				}
			],
			"description": "Endpoint for holding a persistent conversation with a storefront-aware Claude model\n\nCurrently using Claude 4.5 Haiku by default."
		},
